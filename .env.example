# Copy to .env.local for development (never commit .env.local).
# Values for local development come from `npm run db:start` output.

# Public — embedded in the browser bundle at build time. No secrets here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — bypasses Row-Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
